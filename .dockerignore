.git
.gitattributes
.gitignore
vendor
node_modules
.env
.env.*
!.env.example
tests

# The vod-timer OCR pipeline. Run by hand out of its own image
# (tools/vod-timer/Dockerfile) against a bind-mounted checkout, never by the app -
# nothing in app/, config/, routes/, resources/ or database/ references it. Kept out
# of the image so deploy.yml can paths-ignore it without production drifting from the
# commit that built it.
tools

docker-compose*
docker-compose
readme.md
.editorconfig
.phpunit.result.cache
storage/logs/*
!storage/logs/.gitignore
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*

# Package-discovery manifests generated by the dev container's *full*
# (incl. dev) dependency set — must not leak into a --no-dev build, which
# regenerates its own during `composer install`.
bootstrap/cache/*.php
